# Copia este archivo a .env y ajusta los valores.
# En el servidor, EEG_SIM_HOST debe ser la IP de Tailscale de la maquina
# donde corre Pure Data (no una IP publica, no 127.0.0.1).

EEG_SIM_HOST=100.x.x.x
EEG_SIM_PORT=9000
EEG_SIM_RATE=10
EEG_SIM_CALIBRATION=60
EEG_SIM_BASELINE_BPS=72

# Ciclo automatico (recomendado en el servidor, sin nadie escribiendo comandos):
EEG_SIM_AUTO_LOOP=true
EEG_SIM_POST_KICK_SECONDS=20
# EEG_SIM_AUTO_KICK_AFTER=  # si se deja vacio, en auto-loop patea solo en un momento random (15-45s)
