[Unit]
Description=Simulador EEG -> OSC para La Asociacion
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
User=eegsim
WorkingDirectory=/opt/la-asociacion/simulator
EnvironmentFile=/opt/la-asociacion/simulator/.env
ExecStart=/usr/bin/node src/index.js
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
