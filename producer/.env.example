# Copia este archivo a .env y ajusta los valores.
# Igual que simulator/.env.example: esto NO se carga solo al correr
# "python muse_producer.py" a mano -- hace falta exportarlo al shell, o (en
# el evento) referenciarlo desde un EnvironmentFile= de systemd. Un flag por
# linea de comandos siempre gana sobre el valor del .env.

EEG_PRODUCER_HOST=127.0.0.1
EEG_PRODUCER_PORT=9000
EEG_PRODUCER_RATE=10
EEG_PRODUCER_CALIBRATION=60
# segundos iniciales de la calibracion que se ignoran (electrodos asentandose)
EEG_PRODUCER_CALIB_SETTLE=10
EEG_PRODUCER_BASELINE_BPM=72

# Movimiento: con auto=true la calibracion mide el reposo y fija la escala y el
# umbral de patada solos. Los dos valores de abajo son solo el fallback para
# auto=false (forzar valores conocidos).
EEG_PRODUCER_MOVEMENT_AUTO=true
EEG_PRODUCER_MOVEMENT_SCALE=50
EEG_PRODUCER_KICK_THRESHOLD=0.6
EEG_PRODUCER_KICK_REFRACTORY=5

# Rara vez hace falta tocar estos:
EEG_PRODUCER_STREAM_TIMEOUT=5
EEG_PRODUCER_SKIP_CALIBRATION=false
EEG_PRODUCER_DEBUG=false
