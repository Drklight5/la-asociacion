#N canvas 60 60 700 500 12;
#X text 20 15 Patch de prueba: recibe los datos simulados por OSC/UDP.;
#X text 20 32 Corre primero el simulador de Node (simulator/) y luego abre esto.;
#X text 20 49 oscparse descompone la direccion OSC en simbolos separados por "/".;
#X text 20 66 Ej: /eeg/wave/delta 0.5 llega como la lista: eeg wave delta 0.5;
#X obj 20 100 netreceive -u -b 9000;
#X obj 20 140 oscparse;
#X obj 20 180 route eeg;
#X obj 300 220 print no-es-eeg;
#X obj 20 220 route wave bps movement moment;
#X obj 20 280 print wave;
#X obj 140 280 print bps;
#X obj 260 280 print movement;
#X obj 20 320 print moment;
#X obj 140 320 print otro-eeg;
#X connect 4 0 5 0;
#X connect 5 0 6 0;
#X connect 6 0 8 0;
#X connect 6 1 7 0;
#X connect 8 0 9 0;
#X connect 8 1 10 0;
#X connect 8 2 11 0;
#X connect 8 3 12 0;
#X connect 8 4 13 0;
